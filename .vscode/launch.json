{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch integration-havochvatten",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/integration-havochvatten",
            "env": {
                "HOV_BADPLATSEN_URL": "https://gw-test.havochvatten.se/external-public/bathing-waters/v2",
                "NUTS_CODES": "SE0441264000000306",
                "INCLUDE_FUTURE_FORECASTS": "false",
                "LWM2M_ENDPOINT_URL": "http://localhost:8080/api/v0/messages/lwm2m"
            },
            "args": ["-test=true"]
        }
    ]
}
